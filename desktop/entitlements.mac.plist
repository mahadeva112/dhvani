<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- The app forks a Node child process to run the DHVANI backend. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <!-- Reaches api.elevenlabs.io and generativelanguage.googleapis.com. -->
    <key>com.apple.security.network.client</key>
    <true/>
    <!-- Serves the UI on 127.0.0.1 for the app's own window. -->
    <key>com.apple.security.network.server</key>
    <true/>
    <!-- Opening the audio or video file the user picks. -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
  </dict>
</plist>
