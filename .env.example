# ---------------------------------------------------------------------------
# DHVANI — Local Standalone Configuration
# Copy this file to `.env` and fill in your own keys. Never commit `.env`.
#
# Everything here is a STARTING POINT, not a lock. These values seed an install
# that has never been configured; anything you then enter in the app's API
# Settings screen is saved to this computer's own config folder and takes over
# from there. That is what lets one build be shared by people who each have
# their own keys, gateway host and model names.
#
# To make this file the last word instead, set ALLOW_KEY_SETUP=false at the
# bottom: the app then refuses to save anything and only reads from here.
# ---------------------------------------------------------------------------

# ElevenLabs — SOURCE OF TRUTH for transcription, word timestamps and TTS.
# Get a key at https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# Google Gemini — used ONLY for translation / text tasks.
# Get a key at https://aistudio.google.com/apikey  (the key works standalone;
# the app never talks to the AI Studio platform itself).
#
# Leave this blank if you are using your own LLM gateway below instead.
GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# Optional: your own LLM gateway instead of calling Google directly
# ---------------------------------------------------------------------------
# Point translation at a gateway you run (LiteLLM, vLLM, OpenRouter, one-api,
# Portkey, LocalAI...). When a URL and key are both set, this replaces
# GEMINI_API_KEY for translation. ElevenLabs transcription is unaffected, so
# subtitle timing is identical either way.

# Base URL. The version path is optional — a bare host:port, a /v1 URL and a
# full /v1/chat/completions endpoint are all accepted and normalised.
#   http://172.18.1.17:14005
#   https://gateway.example.com/v1
LLM_GATEWAY_URL=

# Bearer token for the gateway (usually starts with sk-).
# Optional for a gateway on localhost or a private network; required otherwise.
LLM_GATEWAY_KEY=

# Wire format your gateway speaks:
#   openai  POST /chat/completions with "Authorization: Bearer ..."  (default)
#   gemini  POST /models/<model>:generateContent with "x-goog-api-key"
LLM_GATEWAY_PROTOCOL=openai

# Model names exactly as your gateway exposes them, tried in order. LiteLLM's
# provider prefixes are fine. Leave blank to auto-pick from the gateway's list.
LLM_GATEWAY_MODELS=

# Output token budget per gateway call. Reasoning models (gemini-2.5-pro,
# o-series) spend tokens thinking before emitting any text, so a small budget
# makes them return nothing at all. Raise it if a reasoning model truncates.
LLM_GATEWAY_MAX_TOKENS=8192

# ---------------------------------------------------------------------------
# Optional tuning
# ---------------------------------------------------------------------------

# Backend port (the Vite dev server proxies /api to this port).
PORT=8787

# Vite dev server port.
CLIENT_PORT=3000

# Network interface to bind to. Keep this on 127.0.0.1 unless you have put
# authentication in front of DHVANI — anyone who can reach the port can spend
# your API credits.
HOST=127.0.0.1

# Comma-separated extra origins allowed to call the backend. The server's own
# origin is always allowed, so you rarely need to change this.
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# --- Endpoints and models (all editable in the app under API Settings) -------

# ElevenLabs API base URL. Change it only for a proxy or a mirror; a bare host
# gets /v1 appended automatically.
ELEVENLABS_BASE_URL=https://api.elevenlabs.io/v1

# ElevenLabs speech-to-text model: scribe_v1 | scribe_v1_experimental
ELEVENLABS_STT_MODEL=scribe_v1

# ElevenLabs default text-to-speech model.
ELEVENLABS_TTS_MODEL=eleven_v3

# Gemini API base URL. Leave blank for Google's own endpoint; set it for a
# corporate or regional proxy that speaks the same API. This is NOT the gateway
# slot above - it still talks the Gemini API, just to a different host.
GEMINI_BASE_URL=

# Gemini translation models, tried in order until one succeeds.
GEMINI_TRANSLATION_MODELS=gemini-2.5-flash,gemini-2.0-flash

# Gemini text-to-speech model (only used when the TTS provider is set to Gemini).
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts

# Max upload size in megabytes.
MAX_UPLOAD_MB=1024

# How many subtitle cues are sent to Gemini per translation request.
TRANSLATION_BATCH_SIZE=40

# Set to "false" to skip ffmpeg audio extraction and upload the original file.
EXTRACT_AUDIO_FROM_VIDEO=true

# Requests per minute per IP against /api. This exists to stop a stuck retry
# loop from spending real money, not to stop an attacker. Set 0 to disable.
RATE_LIMIT_PER_MINUTE=120

# Allows the in-app setup screen to save keys, endpoints and model names to
# this machine's config folder. Only ever honoured for requests from 127.0.0.1.
# Set false behind a reverse proxy, or when this file must be the last word.
ALLOW_KEY_SETUP=true

# Where saved settings live. Defaults to the OS config directory
# (%APPDATA%\dhvani on Windows, ~/.config/dhvani on Linux).
# DHVANI_CONFIG_DIR=
